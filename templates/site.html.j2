<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ site_title }}</title>
<meta name="description" content="Daily FX, China–Europe freight, tax &amp; policy newsflow and economic indicators for Moyne Roberts.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📈</text></svg>">
<script src="assets/vendor/chart.umd.js" defer></script>
<script src="assets/vendor/chartjs-adapter-date-fns.bundle.min.js" defer></script>
<style>
:root{
  color-scheme:light;
  --plane:#f9f9f7; --surface:#fcfcfb; --ink:#0b0b0b; --ink-2:#52514e; --muted:#898781;
  --grid:#e1e0d9; --axis:#c3c2b7; --hair:rgba(11,11,11,.10); --wash:#f0efec;
  --good:#006300; --bad:#e34948; --accent:#1c5cab; --accent-wash:#f2f7fd;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --s5:#e87ba4; --s6:#008300;
  --header-bg:#0b0b0b; --header-ink:#ffffff; --header-ink-2:#c3c2b7;
}
@media (prefers-color-scheme:dark){ :root:where(:not([data-theme="light"])){
  color-scheme:dark;
  --plane:#0d0d0d; --surface:#1a1a19; --ink:#fff; --ink-2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --hair:rgba(255,255,255,.10); --wash:#232321;
  --good:#0ca30c; --bad:#e66767; --accent:#86b6ef; --accent-wash:#16202c;
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#008300;
  --header-bg:#000000; --header-ink:#ffffff; --header-ink-2:#c3c2b7;
}}
:root[data-theme="dark"]{
  color-scheme:dark;
  --plane:#0d0d0d; --surface:#1a1a19; --ink:#fff; --ink-2:#c3c2b7; --muted:#898781;
  --grid:#2c2c2a; --axis:#383835; --hair:rgba(255,255,255,.10); --wash:#232321;
  --good:#0ca30c; --bad:#e66767; --accent:#86b6ef; --accent-wash:#16202c;
  --s1:#3987e5; --s2:#d95926; --s3:#199e70; --s4:#c98500; --s5:#d55181; --s6:#008300;
  --header-bg:#000000; --header-ink:#ffffff; --header-ink-2:#c3c2b7;
}
*{box-sizing:border-box}
body{margin:0;background:var(--plane);color:var(--ink);
  font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;}
a{color:inherit}
.wrap{max-width:1120px;margin:0 auto;padding:0 18px 64px}
header.top{background:var(--header-bg);color:var(--header-ink)}
header.top .wrap{padding-block:26px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between}
header.top h1{margin:0;font-size:20px;letter-spacing:-.3px;color:var(--header-ink)}
header.top p{margin:5px 0 0;font-size:13px;color:var(--header-ink-2)}
.themebtn{background:transparent;border:1px solid rgba(255,255,255,.25);color:var(--header-ink);border-radius:999px;
  padding:7px 14px;font:inherit;font-size:13px;cursor:pointer}
.themebtn:hover{background:rgba(255,255,255,.10)}
h2{font-size:13px;letter-spacing:1.1px;text-transform:uppercase;color:var(--muted);margin:38px 0 14px;font-weight:700}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:14px}
.card{background:var(--surface);border:1px solid var(--hair);border-radius:12px;padding:16px 17px}
.card .lbl{font-size:12px;color:var(--ink-2);font-weight:600}
.card .val{font-size:27px;font-weight:700;letter-spacing:-.6px;margin-top:5px}
.card .chg{font-size:13px;font-weight:600;margin-top:3px}
.card .note{font-size:11px;color:var(--muted);margin-top:6px;line-height:1.45}
.up{color:var(--good)} .down{color:var(--bad)} .flat{color:var(--muted)}
.panel{background:var(--surface);border:1px solid var(--hair);border-radius:12px;padding:18px 20px;margin-bottom:16px}
.panel h3{margin:0 0 3px;font-size:16px;letter-spacing:-.2px}
.panel .sub{margin:0 0 14px;font-size:12.5px;color:var(--ink-2)}
.chartbox{position:relative;height:290px}
.chartbox.tall{height:330px}
table.data{width:100%;border-collapse:collapse;font-size:13px;margin-top:14px}
table.data th{text-align:left;color:var(--ink-2);font-weight:600;font-size:11.5px;letter-spacing:.4px;
  text-transform:uppercase;padding:8px 10px;border-bottom:1px solid var(--grid)}
table.data td{padding:9px 10px;border-bottom:1px solid var(--wash)}
table.data td.num,table.data th.num{text-align:right;white-space:nowrap}
table.data tr:last-child td{border-bottom:0}
.swatch{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px;vertical-align:baseline}
.news{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:16px}
.news .panel{margin:0}
.item{padding:11px 0;border-bottom:1px solid var(--wash)}
.item:last-child{border-bottom:0;padding-bottom:0}
.item a{font-size:14px;font-weight:600;line-height:1.45;text-decoration:none;display:block}
.item a:hover{color:var(--accent);text-decoration:underline}
.meta{font-size:11.5px;color:var(--muted);margin-top:4px}
.tag{background:var(--accent-wash);color:var(--accent);border-radius:999px;padding:1px 8px;font-size:10.5px;font-weight:700;letter-spacing:.3px}
.tag.official{background:rgba(0,99,0,.12);color:var(--good)}
.notice{background:var(--accent-wash);border-left:3px solid var(--s1);border-radius:0 8px 8px 0;padding:13px 16px;font-size:13.5px;margin-bottom:16px}
.warn{background:rgba(237,161,0,.12);border-left-color:var(--s4)}
.warn a{color:inherit}
footer{margin-top:44px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--muted);line-height:1.7}
.pill{display:inline-block;font-size:11px;color:var(--ink-2);background:var(--wash);border-radius:999px;padding:3px 10px;margin:0 6px 6px 0}
@media(max-width:640px){.chartbox{height:240px}.card .val{font-size:23px}}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <div>
    <h1>{{ site_title }}</h1>
    <p>{{ date_long }} &nbsp;·&nbsp; {{ site_tagline }}</p>
  </div>
  <button class="themebtn" id="theme-toggle" type="button">Toggle theme</button>
</div></header>

<main class="wrap">

  {% if degraded %}<div class="notice warn" style="margin-top:22px">{{ degraded }}</div>{% endif %}

  <h2>At a glance</h2>
  <div class="cards">
  {% for card in glance %}
    <div class="card">
      <div class="lbl">{{ card.label }}</div>
      <div class="val">{{ card.value }}</div>
      <div class="chg {{ card.cls }}">{{ card.arrow }} {{ card.change }}</div>
      <div class="note">{{ card.note }}</div>
    </div>
  {% endfor %}
  </div>

  {% if summary_lines %}
  <h2>What moved</h2>
  <div class="notice">
    {% for line in summary_lines %}<div>• {{ line }}</div>{% endfor %}
  </div>
  {% endif %}

  <h2>Foreign exchange</h2>
  {% for pair in fx.pairs %}
  <div class="panel">
    <h3>{{ pair.label }} — {{ pair.value_fmt }}</h3>
    <p class="sub">{{ pair.blurb }}{% if pair.as_of %} · ECB reference rate, {{ pair.as_of }} · {{ pair.observations }} observations{% endif %}</p>
    {% if pair.points %}
      <div class="chartbox"><canvas id="chart-fx-{{ pair.key }}"></canvas></div>
      <table class="data">
        <tr><th>Window</th>{% for label, _ in pair.change_row %}<th class="num">{{ label }}</th>{% endfor %}<th class="num">52w low</th><th class="num">52w high</th></tr>
        <tr><td>Change</td>
          {% for _, value in pair.change_row %}<td class="num {{ value.cls }}">{{ value.text }}</td>{% endfor %}
          <td class="num">{{ pair.low_52w }}</td><td class="num">{{ pair.high_52w }}</td></tr>
      </table>
    {% else %}
      <div class="notice warn">No rate history available yet — the next successful run will populate this chart.</div>
    {% endif %}
  </div>
  {% endfor %}

  <h2>China → Europe container freight</h2>
  {% if freight.any_data %}
    {% for chart in freight.charts %}
    <div class="panel">
      <h3>{{ chart.title }}</h3>
      <p class="sub">{{ chart.unit }} · {{ chart.series|length }} series tracked</p>
      <div class="chartbox tall"><canvas id="chart-{{ chart.id }}"></canvas></div>
    </div>
    {% endfor %}
    <div class="panel">
      <h3>Freight table</h3>
      <p class="sub">Latest published level and change over each window.</p>
      <table class="data">
        <tr><th>Lane / index</th><th class="num">Latest</th><th class="num">1w</th><th class="num">1m</th><th class="num">3m</th><th class="num">1y</th><th>As of</th></tr>
        {% for lane in freight.rows %}
        <tr>
          <td>{% if lane.colour %}<span class="swatch" style="background:{{ lane.colour }}"></span>{% endif %}{{ lane.label }}</td>
          <td class="num"><strong>{{ lane.value }}</strong></td>
          {% for cell in lane.cells_full %}<td class="num {{ cell.cls }}">{{ cell.text }}</td>{% endfor %}
          <td>{{ lane.as_of or '—' }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <div class="notice warn">
      No container freight index published a readable value on this run. Freight publishers change their page markup from time to time;
      the collector tries Freightos FBX, Drewry WCI and the SCFI in turn and will backfill this chart as soon as one responds.
    </div>
  {% endif %}

  <h2>Leading &amp; lagging economic indicators</h2>
  {% for group in indicator_groups %}
  <div class="panel">
    <h3>{{ group.title }}</h3>
    <p class="sub">{{ group.blurb }}</p>
    <table class="data">
      <tr><th>Indicator</th><th class="num">Latest</th><th class="num">vs prior</th><th class="num">vs year ago</th><th>As of</th><th>Source</th></tr>
      {% for row in group.rows %}
      <tr>
        <td>{{ row.label }}<div class="meta">{{ row.why }}</div></td>
        <td class="num"><strong>{{ row.value }}</strong></td>
        <td class="num {{ row.cls }}">{{ row.arrow }} {{ row.change }}</td>
        <td class="num {{ row.year_cls }}">{{ row.year_change }}</td>
        <td>{{ row.as_of }}</td>
        <td class="meta">{{ row.source }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endfor %}
  {% if not indicator_groups %}
    <div class="notice warn">Indicator sources did not respond on this run.</div>
  {% endif %}

  <h2>Policy, tax, employment &amp; M&amp;A newsflow</h2>
  <div class="news">
  {% for theme in news.themes %}
    {% if theme['items'] %}
    <div class="panel">
      <h3>{{ theme.title }}</h3>
      <p class="sub">{% if theme.widened %}Nothing in the last 36 hours — showing the past week.{% else %}Last 36 hours.{% endif %}</p>
      {% for item in theme['items'] %}
      <div class="item">
        <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>
        <div class="meta">
          {% if item.official %}<span class="tag official">OFFICIAL</span> {% endif %}{{ item.source }} · {{ item.published_display }}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  {% endfor %}
  </div>
  {% if news.total_shown == 0 %}
    <div class="notice warn">No news sources responded on this run.</div>
  {% endif %}

  <footer>
    <div style="margin-bottom:10px">
      {% for source in sources %}<span class="pill">{{ source }}</span>{% endfor %}
    </div>
    Generated {{ generated_at }} · rebuilt automatically every morning and emailed to the distribution list.<br>
    Public data, collected for internal information only — not financial, tax or legal advice. Always confirm figures against the primary source before relying on them.
  </footer>
</main>

<script id="viz-data" type="application/json">{{ chart_data }}</script>
<script>
(function(){
  var KEY='mr-newsflow-theme';
  try{var saved=localStorage.getItem(KEY); if(saved){document.documentElement.setAttribute('data-theme',saved);}}catch(e){}
  var btn=document.getElementById('theme-toggle');
  if(btn){btn.addEventListener('click',function(){
    var cur=document.documentElement.getAttribute('data-theme');
    if(!cur){cur=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}
    var next=cur==='dark'?'light':'dark';
    document.documentElement.setAttribute('data-theme',next);
    try{localStorage.setItem(KEY,next);}catch(e){}
    render();
  });}

  var DATA={};
  try{DATA=JSON.parse(document.getElementById('viz-data').textContent||'{}');}catch(e){DATA={};}
  var instances=[];

  function token(name){return getComputedStyle(document.documentElement).getPropertyValue(name).trim();}

  function build(spec){
    var el=document.getElementById(spec.canvas);
    if(!el||!window.Chart) return;
    var ink=token('--ink'), muted=token('--muted'), grid=token('--grid'), surface=token('--surface');
    var single=spec.series.length===1;
    var ds=spec.series.map(function(s,i){
      var colour=token('--s'+((i%6)+1));
      return {label:s.label,data:s.points.map(function(p){return {x:p[0],y:p[1]};}),
        borderColor:colour,backgroundColor:single?colour+'14':'transparent',
        borderWidth:2,tension:.15,pointRadius:0,pointHoverRadius:5,
        pointHoverBackgroundColor:colour,pointHoverBorderColor:surface,pointHoverBorderWidth:2,
        fill:single};
    });
    instances.push(new Chart(el,{type:'line',data:{datasets:ds},options:{
      responsive:true,maintainAspectRatio:false,
      interaction:{mode:'index',intersect:false},
      plugins:{
        legend:{display:!single,position:'bottom',align:'start',
          labels:{color:muted,usePointStyle:true,pointStyle:'line',boxWidth:22,padding:14,font:{size:11}}},
        tooltip:{backgroundColor:ink,titleColor:surface,bodyColor:surface,padding:10,cornerRadius:7,
          displayColors:true,usePointStyle:true,
          callbacks:{label:function(c){return ' '+c.dataset.label+': '+spec.prefix+
            Number(c.parsed.y).toLocaleString(undefined,{maximumFractionDigits:spec.dp,minimumFractionDigits:spec.dp});}}}
      },
      scales:{
        x:{type:'time',time:{unit:spec.unit||'month'},grid:{display:false},border:{color:grid},
           ticks:{color:muted,maxRotation:0,autoSkipPadding:24,font:{size:11}}},
        y:{grid:{color:grid,drawTicks:false},border:{display:false},
           ticks:{color:muted,padding:8,font:{size:11},
             callback:function(v){return spec.prefix+Number(v).toLocaleString(undefined,{maximumFractionDigits:spec.dp});}}}
      }
    }}));
  }

  function render(){
    instances.forEach(function(c){c.destroy();});
    instances=[];
    (DATA.charts||[]).forEach(build);
  }

  function start(){
    // wait for both chart.js and its date adapter to land
    if(!window.Chart||!(Chart._adapters&&Chart._adapters._date)){return setTimeout(start,60);}
    render();
  }
  if(document.readyState!=='loading'){start();}else{document.addEventListener('DOMContentLoaded',start);}
})();
</script>
</body></html>
